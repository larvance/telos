{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telos Launcher",
  "version": "0.1.0",
  "identifier": "com.larvance.telos-launcher",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Telos Launcher",
        "width": 1024,
        "height": 537,
        "minWidth": 860,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  }
}
