{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telos Launcher",
  "version": "0.1.0",
  "identifier": "com.larvance.telos-launcher",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Telos Launcher",
        "width": 1040,
        "height": 640,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
